{
  "name": "nexus-app",
  "version": "0.2.0",
  "private": true,
  "description": "Nexus — закрытый мессенджер для своих",
  "author": "Nexus",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "vite build && electron-builder",
    "test": "node --test --test-force-exit test/*.test.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.65.0",
    "rcedit": "^5.0.2",
    "svelte": "^5.2.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "io.nexus.chat",
    "productName": "Nexus",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "mediasoup-client": "^3.26.0"
  }
}
